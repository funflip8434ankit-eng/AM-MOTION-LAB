# Copy to backend/.env for local work. Never commit .env or use these placeholders in production.
# PostgreSQL connection string for the database used by this backend.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate a unique random secret with at least 32 characters. Keep it private.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Razorpay Dashboard -> Account & Settings -> API Keys. Start with Test Mode keys.
RAZORPAY_KEY_ID=YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# Google Auth Platform -> Clients. Keep the client secret and refresh token private.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_WEB_CLIENT_SECRET
# Gmail sender refresh token is used for contact mail and student login OTP delivery.
GMAIL_REFRESH_TOKEN=
GMAIL_SUPPORT_EMAIL=funflip8434ankit@gmail.com

# Google AI Studio API key for the study assistant. Keep this on the backend only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_SECOND_FALLBACK_MODEL=gemini-3.8-flash

# Render supplies PORT automatically; 3000 is for local development.
PORT=3000

# Optional custom production website origin for the CORS allowlist.
PUBLIC_SITE_ORIGIN=https://funflip8434ankit-eng.github.io
